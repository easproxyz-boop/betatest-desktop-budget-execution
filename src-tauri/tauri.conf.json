{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "unifynet-budget-execution-system",
  "version": "0.2.3",
  "identifier": "com.erwinaaquino.unifynet-budget-execution-system",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "Budget Execution Management",
        "width": 800,
        "height": 600,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },

  "plugins": {
    "updater": {
      "pubkey": "YOUR_ACTUAL_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/easproxyz-boop/betatest-desktop-budget-execution/releases/latest/download/latest.json"
      ]
    },

    "deep-link": {
      "desktop": {
        "schemes": [
          "unifyph"
        ]
      }
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}